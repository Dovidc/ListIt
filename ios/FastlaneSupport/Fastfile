import Foundation

def shared_env
  env_path = File.expand_path("../.env", __dir__)
  UI.message("Loading env from #{env_path}")
  Dotenv.load(env_path)
end

def ensure_workspace
  unless File.exist?(File.expand_path("../ListIt.xcworkspace", __dir__))
    UI.message("Workspace missing, generating via XcodeGen")
    sh("cd .. && xcodegen generate")
  end
end

desc "Run unit tests for all schemes"
lane :ci_tests do
  shared_env
  ensure_workspace
  run_tests(
    workspace: "../ListIt.xcworkspace",
    scheme: "ListItApp",
    clean: true,
    configuration: "Debug"
  )
end

desc "Build and upload a TestFlight beta"
lane :beta do
  shared_env
  ensure_workspace
  increment_build_number(
    xcodeproj: "../ListIt.xcodeproj"
  )
  build_app(
    workspace: "../ListIt.xcworkspace",
    scheme: "ListItApp",
    export_method: "app-store"
  )
  upload_to_testflight
end
