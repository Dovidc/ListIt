{
  "name": "listit",
  "version": "1.1.0",
  "private": true,
  "type": "commonjs",
  "main": "server.js",
  "engines": {
    "node": "18.20.8"
  },
  "scripts": {
    "start": "node server.js",
    "start:monolith": "node server.js",
    "services:api": "cross-env ENABLE_HTTP_API=true ENABLE_WEBSOCKET=false ENABLE_WORKER=false node server-orchestrated.js",
    "services:websocket": "cross-env ENABLE_HTTP_API=false ENABLE_WEBSOCKET=true ENABLE_WORKER=false node server-orchestrated.js",
    "services:worker": "cross-env ENABLE_HTTP_API=false ENABLE_WEBSOCKET=false ENABLE_WORKER=true node server-orchestrated.js",
    "migrate:latest": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "test": "npm run build:core && NODE_ENV=test node node_modules/jest/bin/jest.js --runInBand",
    "build:core": "node scripts/build-core.js",
    "sync:ios": "npx cap sync ios",
    "open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.940.0",
    "@aws-sdk/s3-request-presigner": "^3.940.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/camera": "^6.1.3",
    "@capacitor/core": "^6.1.2",
    "@capacitor/geolocation": "^6.1.1",
    "@capacitor/push-notifications": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@sendgrid/mail": "^8.1.2",
    "@sentry/node": "^10.30.0",
    "apn": "^2.2.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "openai": "^6.9.1",
    "pg": "^8.16.3",
    "sharp": "^0.34.5",
    "stripe": "^16.6.0",
    "web-push": "^3.6.7",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@capacitor/ios": "^6.1.2",
    "cross-env": "^10.0.0",
    "jest": "^30.1.1",
    "supertest": "^7.1.4",
    "typescript": "^5.9.3"
  }
}
