# Copy this file to .env.local (preferred) or .env for local development.
# Values here are safe defaults and should be customized for your setup.

# Core server configuration
PORT=3000
NODE_ENV=development
JWT_SECRET=dev_jwt_change_me
FRONTEND_ORIGIN=http://localhost:3000,capacitor://localhost
COOKIE_DOMAIN=
PUBLIC_ASSET_BASE=

# Redis (required for production queue durability)
REDIS_URL=redis://localhost:6379
WORKER_QUEUE_PREFIX=listit:jobs

# Database configuration
# Use DATABASE_URL for Postgres or DB_PATH for SQLite (defaults to listit.db).
DATABASE_URL=
DB_PATH=listit.db

# OpenAI integration
OPENAI_API_KEY=

# AWS / S3 storage
S3_BUCKET=
S3_REGION=
S3_PREFIX=public/uploads
AWS_REGION=

# Upload limits
MAX_IMAGE_MB=20
MAX_VIDEO_MB=10

# Nearby search defaults
NEARBY_MAX_RADIUS_M=1609
NEARBY_RESULT_LIMIT=120
NEARBY_CACHE_TTL_MS=20000
NEARBY_CACHE_MAX=200

# Web push notifications (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
PUSH_MAX_PER_USER=10
PUSH_BROADCAST_LIMIT=200
PUSH_FAILURE_MAX=3
PUSH_FAILURE_TTL_DAYS=14
PUSH_STALE_TTL_DAYS=90
PUSH_CLEANUP_INTERVAL_MS=21600000
PUSH_CONTACT_EMAIL=

# iOS Push Notifications (APNs)
# Get these from Apple Developer portal > Keys > Create a new key with APNs enabled
APNS_KEY_ID=          # 10-character key ID from Apple
APNS_TEAM_ID=         # Your Apple Developer Team ID
APNS_BUNDLE_ID=com.listit.app  # Must match your app's bundle identifier
APNS_KEY_CONTENT=     # Contents of your .p8 file (including BEGIN/END lines)
APNS_PRODUCTION=false # Set to 'true' for App Store/TestFlight builds

# Admin bootstrap account
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
